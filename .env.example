# "demo" runs on seeded local data stored in the browser (single device, not shared between users).
# "production" requires Supabase and the migrations in supabase/migrations.
VITE_APP_MODE=demo

# Production only. Use the anon key; never put a service-role key in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
